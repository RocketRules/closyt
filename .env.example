# Closyt Demo — environment variables
# Copy to .env and fill in values.

# Fit-scoring engine URL (auto-detected from Metro on mobile; override if needed)
# EXPO_PUBLIC_FIT_ENGINE_URL=http://127.0.0.1:8000

# Gemini API key for selfie body analysis (recommended — free at aistudio.google.com/apikey)
EXPO_PUBLIC_GEMINI_API_KEY=

# Local-only fallback ranking (disabled by default for Optimization demo)
EXPO_PUBLIC_ALLOW_LOCAL_FALLBACK=false
