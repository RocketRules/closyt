# Closyt Demo — environment variables
# Copy to .env and fill in values.

# Fit-scoring engine URL (default works for local simulator / web)
EXPO_PUBLIC_FIT_ENGINE_URL=http://127.0.0.1:8000
# For physical phone on same Wi-Fi, use your laptop LAN IP:
# EXPO_PUBLIC_FIT_ENGINE_URL=http://192.168.x.x:8000

# Optional: Gemini selfie analysis (body-profile enrichment)
# Get a key from https://aistudio.google.com/apikey
# EXPO_PUBLIC_GEMINI_API_KEY=

# Local-only fallback ranking (disabled by default for Optimization demo)
EXPO_PUBLIC_ALLOW_LOCAL_FALLBACK=false
